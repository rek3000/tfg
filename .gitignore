# Generated by gen-ignore.sh. Edit that, not this.

# Server pack zips: hundreds of MB, re-downloadable from the TFG releases page.
packs/*.zip
# Pre-update snapshots of world/player data. Local safety net, not source.
backups/

# Secrets that may end up in overrides/ (Discord tokens, rcon passwords, ...).
overrides/**/*secret*
overrides/**/*token*
overrides/**/*.key
overrides/**/*.pem

# Pack-owned top-level entries, from TerraFirmaGreg-Modern-0.13.10-serverpack.zip.
# Listed so a stray copy of the pack unpacked in here cannot be
# committed. overrides/ is exempt: holding such files is its job.
/config
/defaultconfigs
/DiscordIntegration-Data
/forge-auto-install.txt
/kubejs
/minecraft_server.jar
/mods
/server-icon.png
/server.properties
/server_starter.conf
/start_server.bat
/start_server.sh
/tacz
